# Set an API origin for cross-origin deployments. Keep empty for same-origin
# routing through the Vite proxy or a local Cloudflare tunnel.
VITE_API_URL=

# Used only by Vite's development server.
API_PROXY_TARGET=http://localhost:3000
WEB_PORT=5173
# Optional comma-separated hostnames for reverse proxies or tunnels.
WEB_ALLOWED_HOSTS=
