# Keep empty for both local use and a single Cloudflare Quick Tunnel pointed at
# port 5173. Vite sends API and Socket.IO traffic to the local API, so browser
# requests stay on the page's origin and localhost is never exposed to remote
# devices. Set a public API origin only for a separately deployed API.
VITE_API_URL=

# Used only by Vite's development server. Keep this pointed at the local API
# even while using a Cloudflare tunnel to this web server.
API_PROXY_TARGET=http://localhost:3000
WEB_PORT=5173
# Local: leave empty. For a Cloudflare Quick Tunnel, set this to just the
# current hostname (no scheme), e.g. example.trycloudflare.com. It changes
# whenever cloudflared starts a new Quick Tunnel; update and restart Vite.
WEB_ALLOWED_HOSTS=
