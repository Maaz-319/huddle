# Local development defaults, matching the services in docker-compose.yml.
# Copy to .env: `cp apps/api/.env.example apps/api/.env`.
# .env is git-ignored and never committed.
#
# Every variable here is validated at boot by src/common/env.validation.ts.
# A missing or malformed value kills the process at startup, on purpose.
#
# Cloudflare Quick Tunnel (single tunnel to the web on port 5173): keep
# DATABASE_URL, REDIS_URL, PORT, and TRUSTED_PROXY_HOPS as they are. Replace
# WEB_ORIGIN and GITHUB_CALLBACK_URL with the current https://<tunnel-host>
# origin and its /auth/github/callback URL. The tunnel hostname changes when
# cloudflared restarts, so also update apps/web/.env's WEB_ALLOWED_HOSTS and
# the GitHub OAuth App's callback URL each time. The tunnel carries browser
# requests through Vite to this local API; do not set the browser API URL to
# localhost or expose port 3000 separately.

NODE_ENV="development"
PORT=3000

DATABASE_URL="postgresql://huddle:huddle@localhost:5432/huddle"
REDIS_URL="redis://localhost:6379"

# Exact origin the browser client is served from. Required by CORS, socket
# origin checks, state-changing request checks, and the OAuth success redirect.
# Local: http://localhost:5173
# Tunnel: https://<current-quick-tunnel-host>
WEB_ORIGIN="http://localhost:5173"

# Reverse-proxy hops in front of the app, for Express's `trust proxy`. Zero
# locally, where nothing is in front. Never a count higher than the proxies
# actually present: every extra hop is one a client can forge past.
TRUSTED_PROXY_HOPS=0
LOG_LEVEL="info"

# GitHub OAuth App credentials. Create one at GitHub -> Settings -> Developer
# settings -> OAuth Apps. The Authorization callback URL registered there
# must exactly match GITHUB_CALLBACK_URL below, or GitHub rejects the login.
# Local: http://localhost:3000/auth/github/callback
# Tunnel via Vite: https://<current-quick-tunnel-host>/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GITHUB_CALLBACK_URL="http://localhost:3000/auth/github/callback"

# Signs the session cookie. Generate a private value with `openssl rand -hex 32`.
# Keep the same value while switching between local and tunnel use so sessions
# remain valid; never use a publicly shared example value.
SESSION_SECRET=""
